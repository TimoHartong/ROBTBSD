/* Line 305 */
bool prop_dictionary_set_and_rel(prop_dictionary_t dict, const char *key, prop_object_t po)
{
	bool rv;

	if (po == NULL)
		return false;
	rv = prop_dictionary_set(dict, key, po);
	prop_object_release(po);
	return rv;
}
